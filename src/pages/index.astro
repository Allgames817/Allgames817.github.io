---
import Layout from '../layouts/Layout.astro';
import { profile, url } from '../data/site';
---
<Layout title="首页" home>
  <section class="home-intro" aria-labelledby="hello">
    <div class="hello-content">
      <img class="portrait" src={url('/images/portrait.webp')} alt={`${profile.name}的照片`} width="96" height="96" decoding="async" fetchpriority="high" />
      <h1 id="hello">你好，我是<span>{profile.name}</span>。</h1>
      <p class="hello-purpose" translate="no"><span class="purpose-zh" lang="zh-CN"><span class="purpose-fragment purpose-context">在代码、书页与生活之间，</span><br class="mobile-break" /><span class="purpose-fragment purpose-conclusion">保持<em class="art-word art-curious">好奇<svg class="word-orbit" viewBox="0 0 140 56" preserveAspectRatio="none" aria-hidden="true"><path pathLength="1" d="M 12 38 C -8 9 59 -3 111 9 C 134 14 146 33 127 44" /></svg></em>，持续<em class="art-word art-creating">创造<svg class="word-spark" width="12" height="12" viewBox="0 0 20 20" aria-hidden="true"><path d="M10 1 C10 7 13 10 19 10 C13 10 10 13 10 19 C10 13 7 10 1 10 C7 10 10 7 10 1Z" /></svg></em>。</span></span><span class="purpose-en" lang="en"><span class="purpose-fragment purpose-context">Between code, pages, and life —</span><br class="purpose-break" /><span class="purpose-fragment purpose-conclusion">staying <span class="focus-unit"><em class="art-word art-curious">curious<svg class="word-orbit" viewBox="0 0 140 56" preserveAspectRatio="none" aria-hidden="true"><path pathLength="1" d="M 12 38 C -8 9 59 -3 111 9 C 134 14 146 33 127 44" /></svg></em>,</span> always <span class="focus-unit"><em class="art-word art-creating">creating<svg class="word-spark" width="12" height="12" viewBox="0 0 20 20" aria-hidden="true"><path d="M10 1 C10 7 13 10 19 10 C13 10 10 13 10 19 C10 13 7 10 1 10 C7 10 10 7 10 1Z" /></svg></em>.</span></span></span></p>
      <p class="hello-focus" translate="no"><span class="focus-zh" lang="zh-CN">探索智能如何<strong class="focus-word" style="--word-order:0">感知世界</strong>、<strong class="focus-word" style="--word-order:1">理解世界</strong>，并<strong class="focus-word" style="--word-order:2">在其中行动</strong>。</span><span class="focus-en" lang="en">Exploring how intelligence <span class="focus-unit"><strong class="focus-word" style="--word-order:0">perceives</strong>,</span> <span class="focus-unit"><strong class="focus-word" style="--word-order:1">understands</strong>,</span> and <strong class="focus-word" style="--word-order:2">acts</strong> in the world.</span></p>
      <div class="hello-links"><a href={url('/about/')}>更多关于我 <span aria-hidden="true">↗</span></a><a href={profile.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub（新窗口）"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.86c-2.78.6-3.37-1.18-3.37-1.18-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.35 1.09 2.92.83.09-.65.35-1.09.64-1.34-2.22-.25-4.56-1.11-4.56-4.95 0-1.09.39-1.99 1.03-2.69-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.03a9.58 9.58 0 0 1 5 0c1.91-1.3 2.75-1.03 2.75-1.03.55 1.38.2 2.4.1 2.65.64.7 1.03 1.6 1.03 2.69 0 3.85-2.34 4.69-4.58 4.94.36.31.68.92.68 1.86v2.75c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"/></svg>GitHub <span aria-hidden="true">↗</span></a><a href={`mailto:${profile.email}`}>{profile.email}</a></div>
    </div>
    <div class="home-end"><p class="home-signoff">看见世界此刻的模样，也想象它未来的模样。</p></div>
  </section>
  <script src="../scripts/home-sky.ts"></script>
</Layout>
