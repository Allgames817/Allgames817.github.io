---
import Layout from '../../layouts/Layout.astro';
import life from '../../data/life.json';
import { url } from '../../data/site';

export function getStaticPaths() {
  return life.notes.map(note => ({ params: { slug: note.slug }, props: { note } }));
}
const { note } = Astro.props;
const openingSections = note.sections.slice(0, 2);
const remainingSections = note.sections.slice(2);
---
<Layout title={note.title} description={note.description} section="/life/">
  <div class="detail-top"><a class="back-link" href={url('/life/#notes-title')}>返回生活随记</a></div>
  <header class="detail-heading">
    <h1>{note.title}</h1>
    <p><time datetime={note.time}>{note.period}</time></p>
  </header>
  <div class="reading-layout">
    <article class="prose note-body">
      <dl class="program-information">
        {note.information.map(item => <div><dt>{item.label}</dt><dd>{item.value}</dd></div>)}
      </dl>
      <div class="note-introduction">
        <div class="note-opening">
          <div class="note-opening-copy">
            {openingSections.map(section => <section aria-labelledby={section.id}>
              <h2 id={section.id}>{section.title}</h2>
              {section.paragraphs.map(paragraph => <p class="source-paragraph">{paragraph}</p>)}
            </section>)}
          </div>
          {openingSections.map(section => section.portrait && <figure class="note-portrait"><img src={url(section.portrait.src)} alt={section.portrait.alt} width={section.portrait.width} height={section.portrait.height} loading="lazy" decoding="async" /></figure>)}
        </div>
        <div class="note-photos">
          {openingSections.flatMap(section => section.images ?? []).map(photo => <figure><img src={url(photo.src)} alt={photo.alt} width={photo.width} height={photo.height} loading="lazy" decoding="async" /></figure>)}
        </div>
      </div>
      {remainingSections.map(section => <section aria-labelledby={section.id}>
        <h2 id={section.id}>{section.title}</h2>
        {section.paragraphs.map(paragraph => <p class="source-paragraph">{paragraph}</p>)}
        {(section.portrait || section.images) && <div class="note-photos">
          {[...(section.portrait ? [section.portrait] : []), ...(section.images ?? [])].map(photo => <figure><img src={url(photo.src)} alt={photo.alt} width={photo.width} height={photo.height} loading="lazy" decoding="async" /></figure>)}
        </div>}
      </section>)}
    </article>
    <aside class="toc">
      <details open>
        <summary>文章目录</summary>
        <nav aria-label="文章目录">{note.sections.map(section => <a href={`#${section.id}`}>{section.title}</a>)}</nav>
      </details>
    </aside>
  </div>
  <a class="back-link end-link" href={url('/life/#notes-title')}>返回生活随记</a>
</Layout>

<style>
  .note-body:lang(zh-CN) { line-height: 1.95; }
  .program-information { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px 32px; margin: 0 0 36px; }
  .program-information dt { color: var(--muted); font-size: 13px; }
  .program-information dd { margin: 2px 0 0; font-size: 15px; overflow-wrap: anywhere; }
  .note-opening { display: grid; grid-template-columns: minmax(0, 1fr) 280px; gap: 28px; align-items: center; }
  .note-opening-copy { min-width: 0; }
  .note-opening-copy section:first-child h2 { margin-top: 0; }
  .note-opening-copy section + section h2 { margin-top: 28px; }
  .note-body .note-portrait { width: 100%; margin: 0; }
  .note-opening section:last-child p:last-child { margin-bottom: 0; }
  .note-photos { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; align-items: start; margin-top: 24px; }
  .note-body .note-photos figure { min-width: 0; margin: 0; }
  .note-body img { display: block; width: 100%; height: auto; }
  @media (max-width: 768px) {
    .program-information { gap: 16px 20px; margin-bottom: 28px; }
    .program-information div:nth-last-child(2) { grid-column: 1 / -1; }
    .note-opening { grid-template-columns: 1fr; gap: 24px; }
    .note-body .note-portrait { max-width: 360px; }
    .note-photos { grid-template-columns: 1fr; }
  }
</style>
