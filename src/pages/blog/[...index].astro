---
import Layout from '../../layouts/Layout.astro';
import PostList from '../../components/PostList.astro';
import Filters from '../../components/Filters.astro';
import features from '../../data/features.json';
export function getStaticPaths() {
  return features.blog ? [{ params: { index: undefined } }] : [];
}
---
<Layout title="博客" section="/blog/" description="关于机器人学习、机器人视觉与 AI 系统的技术笔记。">
  <header class="page-heading"><h1>博客</h1><p>把复杂的东西慢慢理清楚。<br />技术讲解、论文阅读，以及值得记下的问题。</p></header>
  <Filters search categories={['机器人学习', '机器人视觉', 'AI 系统', '课程笔记', '工具与实践']} />
  <section data-result-group aria-labelledby="latest-posts"><h2 class="collection-heading" id="latest-posts">最新文章</h2><PostList /></section>
  <div class="empty-state" data-empty hidden><h2>暂时没有找到这篇笔记</h2><p>试试更短的关键词，或清除筛选条件。</p><button class="button" data-reset>清除搜索与筛选</button></div>
</Layout>
