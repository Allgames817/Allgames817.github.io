---
interface Props { type: 'diffusion' | 'flow' | string; }
const { type } = Astro.props;
const isFlow = type === 'flow';
const content = isFlow ? {
  title: '沿流场生成动作',
  labels: ['噪声轨迹', '条件流场', '动作块'],
  description: '流匹配概念：噪声样本沿观测条件下学习的向量场积分，生成动作块。概念示意，非实验结果。',
} : {
  title: '从噪声到动作',
  labels: ['噪声轨迹', '条件去噪', '动作块'],
  description: '扩散策略概念：噪声轨迹在观测条件下逐步去噪，生成动作块。概念示意，非实验结果。',
};
const actionPoints = [
  [411, 136], [427, 129], [443, 113], [459, 101],
  [475, 98], [491, 105], [507, 119], [523, 126],
];
---
<figure class:list={['diagram', 'generative-policy', `policy-${isFlow ? 'flow' : 'diffusion'}`]}>
  <svg viewBox="0 0 560 204" role="img" aria-label={content.description}>
    <title>{content.title}</title>
    <text x="32" y="37" class="policy-title">{content.title}</text>

    <g aria-hidden="true">
      <rect x="28" y="63" width="144" height="100" rx="6" class="policy-node" />
      <rect x="210" y="63" width="144" height="100" rx="6" class="policy-node policy-active" />
      <rect x="392" y="63" width="144" height="100" rx="6" class="policy-node" />
      <path d="M 179 113 H 201 m -7 -5 7 5 -7 5 M 361 113 H 383 m -7 -5 7 5 -7 5" class="policy-connector" />

      <!-- Irregular samples represent noise; the shapes are conceptual, not measured trajectories. -->
      <path d="M 43 133 58 87 73 144 88 104 103 136 118 82 133 125 158 94" class="policy-path policy-noise" />
      <circle cx="43" cy="133" r="3" class="policy-point" />
      <circle cx="158" cy="94" r="3" class="policy-point" />

      {isFlow ? <>
        <!-- Local directions explain the learned vector field without adding a decorative grid. -->
        <path d="M 224 88 l 14 -5 m -6 -2 6 2 -3 5 M 259 81 l 16 2 m -5 -4 5 4 -6 3 M 296 80 l 14 7 m -3 -6 3 6 -7 0 M 329 96 l 9 11 m 0 -7 0 7 -7 -2 M 224 140 l 14 -7 m -7 -1 7 1 -3 6 M 272 137 l 15 -3 m -6 -2 6 2 -4 5 M 313 133 l 14 6 m -3 -6 3 6 -7 1" class="policy-field" />
        <path d="M 225 126 C 244 127 250 108 269 99 S 302 97 317 108 S 333 127 340 126" class="policy-path" />
        <circle cx="225" cy="126" r="3" class="policy-point" />
        <path d="m 333 122 7 4 -6 5" class="policy-connector" />
      </> : <>
        <!-- Three nested paths show progressively less noise in the same action sample. -->
        <path d="M 225 131 240 88 255 137 270 96 285 126 300 84 315 130 340 97" class="policy-path policy-stage-early" />
        <path d="M 225 132 240 117 255 122 270 94 285 107 300 96 315 114 340 126" class="policy-path policy-stage-middle" />
        <path d="M 225 136 C 242 132 250 116 268 104 S 295 100 310 112 S 328 128 340 126" class="policy-path" />
        <circle cx="225" cy="136" r="3" class="policy-point" />
        <circle cx="340" cy="126" r="3" class="policy-point" />
      </>}

      <!-- Connected action samples form one predicted chunk rather than a performance chart. -->
      <path d="M 411 136 427 129 443 113 459 101 475 98 491 105 507 119 523 126" class="policy-path" />
      {actionPoints.map(([x, y]) => <rect x={x - 3} y={y - 3} width="6" height="6" rx="1" class="policy-action" />)}
    </g>

    {content.labels.map((label, index) => <text x={100 + index * 182} y="186" text-anchor="middle" class="policy-label">{label}</text>)}
  </svg>
  <figcaption>概念示意 · 非实验截图</figcaption>
</figure>

<style>
  .policy-title { fill: var(--text); font-size: 15px; font-weight: 500; }
  .policy-label { fill: var(--text); font-size: 16px; }
  .policy-node { fill: var(--node); stroke: var(--line); stroke-width: 1.4; }
  .policy-active { fill: var(--accent-soft); stroke: var(--accent); }
  .policy-connector, .policy-path, .policy-field { fill: none; stroke: var(--accent); stroke-linecap: round; stroke-linejoin: round; }
  .policy-connector { stroke-width: 1.5; }
  .policy-path { stroke-width: 2; }
  .policy-noise { stroke: var(--muted); stroke-width: 1.5; }
  .policy-stage-early { stroke: var(--muted); stroke-width: 1.2; stroke-dasharray: 3 4; opacity: .45; }
  .policy-stage-middle { stroke-width: 1.4; opacity: .5; }
  .policy-field { stroke-width: 1.3; opacity: .65; }
  .policy-point, .policy-action { fill: var(--accent); }
  .policy-action { stroke: var(--node); stroke-width: 1; }
  @media (max-width: 768px) {
    .policy-title { font-size: 22px; }
    .policy-label { font-size: 22px; }
    :global(:root[lang=en]) .policy-title { font-size: 20px; }
    :global(:root[lang=en]) .policy-label { font-size: 18px; }
  }
</style>
